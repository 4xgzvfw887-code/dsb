# Kopiere nach .env und fülle nur aus, was du brauchst.
# Paper-Trading funktioniert OHNE API-Keys.

# Exchange API (nur für Live-Trading / echte Order-Ausführung)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=

# Optional: Override der Config
# TRADEFORGE_MODE=paper
# TRADEFORGE_SYMBOL=BTC/USDT
